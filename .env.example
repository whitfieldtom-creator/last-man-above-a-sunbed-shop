# Copy to .env.local and fill in real values. Never commit .env.local.

DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
# "123" is TheSportsDB's public shared free-tier key — see plan section 11.
SPORTSDB_API_KEY="123"
CRON_SECRET=""

# JSON map of player name -> plaintext passcode, hashed on seed. Only needed
# locally when re-running `prisma db seed`; never committed.
PLAYER_PASSCODES={}
