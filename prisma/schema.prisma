// Prisma schema for Last Man Above A Sunbed Shop
// Data model: last-man-standing-plan.md section 5

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  createdAt    DateTime @default(now())
  // salt:hash (scrypt) — set via the seed script, not a self-serve field.
  // Lightweight per-player gate, not real auth (see plan section 8).
  passcodeHash String?

  wonRuns           Run[]              @relation("RunWinners")
  runEntries        RunEntry[]
  lmsPicks          LmsPick[]
  predictorPicks    PredictorPick[]
  playerLeagueLives PlayerLeagueLife[]
}

model League {
  id   Int    @id @default(autoincrement())
  name String @unique

  fixtures          Fixture[]
  lmsPicks          LmsPick[]
  playerLeagueLives PlayerLeagueLife[]
}

model Run {
  id        Int       @id @default(autoincrement())
  runNumber Int       @unique
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  // Normally one player, but a shared final-week elimination (everyone still
  // in the run loses their last life the same week) makes them joint winners.
  winners           Player[]           @relation("RunWinners")
  gameWeeks         GameWeek[]
  runEntries        RunEntry[]
  playerLeagueLives PlayerLeagueLife[]
}

enum GameWeekStatus {
  open
  locked
  settled
  skipped
}

model GameWeek {
  id           Int            @id @default(autoincrement())
  runId        Int
  weekNumber   Int
  windowStart  DateTime
  windowEnd    DateTime
  pickDeadline DateTime
  status       GameWeekStatus @default(open)
  // Set once the Friday deadline report email has been sent for this week —
  // see section 6a. Guards against a double-send from the two DST-covering
  // cron triggers both landing in the match window in the same run.
  reportSentAt DateTime?
  // True when a league that anyone still has a life in has no fixtures this
  // week (see section 2): no LMS picks, nobody loses a life, but the Score Predictor still runs.
  // Deliberately separate from `status` — a "skipped" status hides the
  // whole week (Predictor included), which isn't wanted here.
  lmsSkipped Boolean @default(false)

  run               Run                @relation(fields: [runId], references: [id])
  fixtures          Fixture[]
  predictorFixtures PredictorFixture[]
  lmsPicks          LmsPick[]
  eliminations      RunEntry[]

  @@unique([runId, weekNumber])
}

// One row per player per LMS run — tracks whether they're fully out of the
// run overall. The source of truth for *which* lives they have left is
// PlayerLeagueLife (one life per league, see below); `eliminated` here just
// mirrors "all four of that player's PlayerLeagueLife rows are alive=false",
// kept as its own column so run-ending/payout logic (awardLmsPayouts) doesn't
// need to re-derive it from four rows every time. See section 6.
model RunEntry {
  id                 Int      @id @default(autoincrement())
  runId              Int
  playerId           Int
  eliminated         Boolean  @default(false)
  eliminatedAtWeekId Int?
  // Null while the run is still in progress; set to the player's share of
  // the run's points pot (0 if they didn't place) once the run ends —
  // see section 6a (points pot).
  lmsPointsAwarded   Float?

  run              Run       @relation(fields: [runId], references: [id])
  player           Player    @relation(fields: [playerId], references: [id])
  eliminatedAtWeek GameWeek? @relation(fields: [eliminatedAtWeekId], references: [id])

  @@unique([runId, playerId])
}

// One row per player per league per run — the actual per-league life (see
// section 6). A wrong/missing/postponed pick in that league sets alive to
// false, which removes that league from the player's pick screen for the
// rest of the run. A player is fully out (RunEntry.eliminated) once all four
// of their rows here are alive=false.
model PlayerLeagueLife {
  id       Int     @id @default(autoincrement())
  runId    Int
  playerId Int
  leagueId Int
  alive    Boolean @default(true)
  // The game week in which this life was lost (null while still alive) —
  // what the ticker reads to announce last week's losses.
  lostAtWeekId Int?

  run    Run    @relation(fields: [runId], references: [id])
  player Player @relation(fields: [playerId], references: [id])
  league League @relation(fields: [leagueId], references: [id])

  @@unique([runId, playerId, leagueId])
}

enum FixtureResult {
  pending
  home
  away
  draw
  postponed
}

model Fixture {
  id          Int           @id @default(autoincrement())
  gameWeekId  Int
  leagueId    Int
  homeTeam    String
  awayTeam    String
  kickoffTime DateTime
  result      FixtureResult @default(pending)
  homeScore   Int?
  awayScore   Int?
  externalId  String        @unique

  gameWeek         GameWeek          @relation(fields: [gameWeekId], references: [id])
  league           League            @relation(fields: [leagueId], references: [id])
  predictorFixture PredictorFixture?
  lmsPicks         LmsPick[]
}

model PredictorFixture {
  id         Int @id @default(autoincrement())
  gameWeekId Int
  fixtureId  Int @unique

  gameWeek       GameWeek        @relation(fields: [gameWeekId], references: [id])
  fixture        Fixture         @relation(fields: [fixtureId], references: [id])
  predictorPicks PredictorPick[]
}

model LmsPick {
  id         Int      @id @default(autoincrement())
  playerId   Int
  gameWeekId Int
  leagueId   Int
  fixtureId  Int
  teamPicked String
  correct    Boolean?

  player   Player   @relation(fields: [playerId], references: [id])
  gameWeek GameWeek @relation(fields: [gameWeekId], references: [id])
  league   League   @relation(fields: [leagueId], references: [id])
  fixture  Fixture  @relation(fields: [fixtureId], references: [id])

  @@unique([playerId, gameWeekId, leagueId])
}

model PredictorPick {
  id                 Int  @id @default(autoincrement())
  playerId           Int
  predictorFixtureId Int
  predictedHomeScore Int
  predictedAwayScore Int
  pointsAwarded      Int?

  player           Player           @relation(fields: [playerId], references: [id])
  predictorFixture PredictorFixture @relation(fields: [predictorFixtureId], references: [id])

  @@unique([playerId, predictorFixtureId])
}
